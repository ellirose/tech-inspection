# Copy to .env.local for development. Real values live only on the server and in GitHub Actions secrets.
# Grouped by the back-end stage that first needs them; empty optional values switch the feature off.

# --- Site ---------------------------------------------------------------
# Canonical origin for metadata and the sitemap. Leave commented to use https://www.tech-inspection.com.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (stage 1) ---------------------------------------------------
# docker compose and `npm run db:dev` both listen on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/techinspection

# --- Auth (stage 3) -------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=

# --- Leads and email (stage 2) --------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Tech-Inspection <notificaciones@send.tech-inspection.com>"
LEAD_NOTIFY_TO=
# Cloudflare's public test keys (always pass) until the real ones exist.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
REDIS_URL=redis://localhost:6380

# Optional copy of every lead: none | sheets | hubspot
LEAD_SYNC=none
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
HUBSPOT_TOKEN=

# --- File storage (stage 5) -----------------------------------------------
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=

# --- Chatbot (stage 6) ----------------------------------------------------
ANTHROPIC_API_KEY=

# --- Analytics (stage 7) --------------------------------------------------
NEXT_PUBLIC_GTM_ID=
