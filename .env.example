# Copy to .env.local for development. Real values live only on the server and in GitHub Actions secrets.
# Grouped by the back-end stage that first needs them; empty optional values switch the feature off.

# --- Site ---------------------------------------------------------------
# Canonical origin for metadata and the sitemap. Leave commented to use https://www.tech-inspection.com.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (stage 1) ---------------------------------------------------
# docker compose and `npm run db:dev` both listen on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/techinspection

# --- Admin panel (stage 3) ------------------------------------------------
# Signs session cookies and encrypts two-factor secrets. Generate with: openssl rand -base64 32
# Changing it signs everyone out and invalidates two-factor setups.
AUTH_SECRET=
# Public origin of the site; links in setup emails and the allowed origin for sign-in requests.
AUTH_URL=http://localhost:3000
# First super-admin, created by `npm run admin:invite -- --bootstrap`.
ADMIN_BOOTSTRAP_EMAIL=

# --- Leads and email (stage 2) --------------------------------------------
# Comma-separated mailboxes that receive every new lead, used until recipients are set under Configuración.
LEAD_NOTIFY_TO=
# Sends through Resend when set. Without it, development writes each email as an .html file to
# EMAIL_OUTBOX_DIR; with neither, email is off and only the subject is logged.
RESEND_API_KEY=
EMAIL_FROM="Tech-Inspection <notificaciones@send.tech-inspection.com>"
EMAIL_OUTBOX_DIR=.data/outbox
# Cloudflare's public test keys (always pass) until the real ones exist. Empty switches the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Rate limits are kept in PostgreSQL (table rate_limit); no Redis needed.

# --- File storage (stage 5) -----------------------------------------------
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=

# --- Chatbot (stage 6) ----------------------------------------------------
ANTHROPIC_API_KEY=

# --- Analytics (stage 7) --------------------------------------------------
NEXT_PUBLIC_GTM_ID=
